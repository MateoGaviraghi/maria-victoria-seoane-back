{
  "info": {
    "name": "Fase 2 - Sistema de Emails y Configuración",
    "description": "Endpoints del sistema de emails automatizados y configuración del sitio",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "email_log_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth - Login (para obtener token)",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', res.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Hacer login como admin para obtener el token de acceso. El token se guarda automáticamente."
          }
        }
      ]
    },
    {
      "name": "⚙️ Site Config - Configuración del Sitio",
      "item": [
        {
          "name": "Get All Configs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/site-config",
              "host": ["{{baseUrl}}"],
              "path": ["site-config"]
            },
            "description": "Obtiene todas las configuraciones del sitio"
          }
        },
        {
          "name": "Get Email Settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/site-config/emails/settings",
              "host": ["{{baseUrl}}"],
              "path": ["site-config", "emails", "settings"]
            },
            "description": "Obtiene la configuración actual de emails automáticos"
          }
        },
        {
          "name": "Update Email Settings",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cartAbandoned1hHours\": 1,\n  \"cartAbandoned24hHours\": 24,\n  \"cartAbandoned72hHours\": 72,\n  \"firstCouponDiscount\": 10,\n  \"secondCouponDiscount\": 15,\n  \"cartAbandonedEnabled\": true,\n  \"birthdayEmailsEnabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/site-config/emails/settings",
              "host": ["{{baseUrl}}"],
              "path": ["site-config", "emails", "settings"]
            },
            "description": "Actualiza los intervalos de carrito abandonado y descuentos de cupones"
          }
        },
        {
          "name": "Get Config by Key",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/site-config/EMAIL_CONFIG",
              "host": ["{{baseUrl}}"],
              "path": ["site-config", "EMAIL_CONFIG"]
            },
            "description": "Obtiene una configuración específica por su clave"
          }
        }
      ]
    },
    {
      "name": "📧 Emails - Sistema de Emails",
      "item": [
        {
          "name": "Get Email Logs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().data.logs.length > 0) {",
                  "    const firstLog = pm.response.json().data.logs[0];",
                  "    pm.collectionVariables.set('email_log_id', firstLog.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/emails/logs?page=1&limit=20&type=&status=",
              "host": ["{{baseUrl}}"],
              "path": ["emails", "logs"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número de página"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Emails por página"
                },
                {
                  "key": "type",
                  "value": "",
                  "description": "Filtrar por tipo"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "Filtrar por estado"
                }
              ]
            },
            "description": "Obtiene el historial de emails enviados con paginación y filtros"
          }
        },
        {
          "name": "Get Email Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/emails/stats",
              "host": ["{{baseUrl}}"],
              "path": ["emails", "stats"]
            },
            "description": "Obtiene estadísticas generales de emails"
          }
        },
